# URL of the deployed backend (Render). No trailing slash.
VITE_SERVER_URL=https://your-backend.onrender.com

# TURN server — required in production. Without this, calls fail for anyone
# on mobile data, corporate/school networks, or behind symmetric NAT/strict
# firewalls (roughly 15-20% of real-world users). STUN alone (already
# hardcoded in useWebRTC.js/useGroupWebRTC.js) isn't enough for those cases.
#
# Easiest free-tier option: https://www.metered.ca/tools/openrelay/ (free
# TURN credentials, no self-hosting). Alternatives: Twilio Network Traversal
# Service, Xirsys, or self-hosted coturn on a small VPS.
VITE_TURN_URL=turn:your-turn-server.com:3478
VITE_TURN_USERNAME=changeme
VITE_TURN_CREDENTIAL=changeme
