PORT=5000
# Comma-separated list of allowed frontend origins. For most setups just list
# your production Vercel URL (and localhost for dev):
#   CLIENT_URL=http://localhost:5173,https://your-app.vercel.app
# Vercel also generates a new preview URL on every branch/PR deploy, which
# won't match the list above. If you need previews to work too, you can add
# a "*.vercel.app" suffix-wildcard entry — but note that matches ANY
# vercel.app subdomain, not just yours, so only add it if that's an
# acceptable trade-off (there's no cookie-based auth here, so the exposure
# is limited to CORS access, not session hijacking):
#   CLIENT_URL=http://localhost:5173,https://your-app.vercel.app,*.vercel.app
CLIENT_URL=http://localhost:5173,https://your-app.vercel.app
MONGO_URI=mongodb://localhost:27017/randomconnect

# Admin moderation dashboard. Use long random values in production.
ADMIN_PASSWORD=Mayank
ADMIN_SESSION_SECRET=147258

# TURN/STUN — required for WebRTC to work reliably across NATs/firewalls.
# Use a managed provider (Twilio, Xirsys, Metered) or self-hosted coturn.
TURN_URL=turn:your-turn-server.com:3478
TURN_USERNAME=changeme
TURN_CREDENTIAL=changeme

# Image/video moderation provider (nudity/CSAM detection). Do NOT ship
# to production without one of these wired into moderation.js.
MODERATION_PROVIDER=hive
MODERATION_API_KEY=changeme

# Minimum age gate (self-certified — see README for why this is not enough on its own)
MIN_AGE=18
